{
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.jsx",
    "**/*.ts",
    "**/*.mts",
    "**/*.cts",
    "**/*.tsx"
  ],
  "exclude": [
    {
      "glob": "**/dist/**",
      "reason": "Build output repeats its source."
    },
    {
      "glob": "**/build/**",
      "reason": "Build output repeats its source."
    },
    {
      "glob": "**/generated/**",
      "reason": "Generated files repeat their generator."
    },
    {
      "glob": "**/fixtures/**",
      "reason": "Test input reproduces outside data."
    },
    {
      "glob": "**/*.min.js",
      "reason": "Minified files have no authored comments."
    }
  ],
  "limits": {
    "ratio": 1,
    "physical": 1000,
    "minLines": 20
  },
  "exceptions": {},
  "vale": "vale/.vale.ini",
  "astGrep": "ast-grep/sgconfig.yml",
  "cloc": "cloc/options.txt"
}
