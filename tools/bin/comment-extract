#!/usr/bin/env node
// Print every comment line of the selected files as file:line:column:text,
// found by ast-grep's parser, so a string that holds // is not a comment.
import { cli, comments, finish, listFiles, loadConfig, mergeBase, report } from '../lib/common.mjs';

const USAGE = `usage: comment-extract [--base <rev>] [--config <file>] [path...] [-- <ast-grep option>...]

Reads the working tree. With --base, prints only the comment lines added
since the merge base of <rev> and HEAD, uncommitted changes included.
The ast-grep config is the "astGrep" key of comments.json.

Exits 0, or 2 when it cannot run.`;

const opts = cli({ base: { type: 'string' }, config: { type: 'string' } }, USAGE);
const config = loadConfig(opts.config);
const base = opts.base && mergeBase(opts.base);
const files = listFiles(config, opts.paths, { base });

// A comment of several lines becomes one row per line. The first line
// starts at the comment's column; the others at column 1.
let rows = comments(config, files, opts.passthrough).flatMap(c =>
  c.text.split('\n').map((text, i) => ({ file: c.file, line: c.line + i, column: i ? 1 : c.column, message: text.trimEnd() }))
);
if (base && rows.length) rows = report(rows, { base, name: 'comment-extract' }).kept;
finish(rows.map(r => `${r.file}:${r.line}:${r.column}:${r.message}\n`).join(''), 0);
