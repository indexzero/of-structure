#!/usr/bin/env node
// Rule 15 detector: find facts that live in more than one file. It reads the
// output of comment-extract on stdin:
//
//   comment-extract --base main | repeated-facts
//   comment-extract --base main | repeated-facts --min-files 3 --verbatim
//
// No off-the-shelf tool does this job. Clone detectors such as jscpd compare
// code tokens, and only find prose that was pasted.
//
// The TERM pass finds paraphrase, which is what real duplication looks like.
// One invariant stated eight times by one author is eight different sentences
// that share only their rare words. Tested against a diff carrying one
// invariant in eight files, the verbatim pass at 5-grams found ZERO clusters
// and the term pass found it.
//
// KNOWN LIMITATION, measured. The term pass finds a fact by its RARE words, so
// it is blind to a fact whose words are the change's own vocabulary. A
// tombstone repeated in four of ten files went unseen, because its giveaway
// word was in all ten. comment-lint's Comments.Tombstone rule holds that case.
// Do not extend the term pass to cover it.
//
// Every cluster is a CANDIDATE. A repeated term set is a finding when two
// places state the same fact authoritatively. It is not a finding when a test
// names the rule it tests and points at where that rule lives.
import fs from 'node:fs';
import tty from 'node:tty';
import { parseArgs } from 'node:util';

const USAGE = 'usage: comment-extract [...] | repeated-facts [--min-files <n>] [--ngram <n>] [--top <n>] [--verbatim]';
let values;
try {
  ({ values } = parseArgs({
    options: {
      'min-files': { type: 'string', default: '2' },
      ngram: { type: 'string', default: '5' },
      top: { type: 'string', default: '12' },
      verbatim: { type: 'boolean' },
      help: { type: 'boolean', short: 'h' },
    },
  }));
} catch (e) {
  console.error(`${e.message}\n${USAGE}`);
  process.exit(2);
}
// tty.isatty, not process.stdin.isTTY: touching process.stdin puts fd 0 in
// non-blocking mode, and the read below then fails with EAGAIN on a pipe.
if (values.help || tty.isatty(0)) {
  console.log(USAGE);
  process.exit(values.help ? 0 : 2);
}
const count = name => {
  const n = Number(values[name]);
  if (!Number.isInteger(n) || n < 1) {
    console.error(`--${name} must be a whole number of 1 or more\n${USAGE}`);
    process.exit(2);
  }
  return n;
};
const MIN_FILES = count('min-files');
const NGRAM = count('ngram');
const TOP = count('top');

// Deliberately short. An aggressive stop list hides the repetitions we hunt.
const STOP = new Set(
  ('the a an and or of to in is it that this for on as at by be are was so not no but with from has ' +
   'have its if than then which what when where how why can will its it\'s one two only just also ' +
   'here there they them their we you your our all any each every some more most other same such')
    .split(' ')
);

const comments = [];
for (const line of fs.readFileSync(0, 'utf8').split('\n')) {
  const m = line.match(/^(.+?):(\d+):\d+:(.*)$/);
  if (m && m[3].trim()) comments.push({ file: m[1], line: Number(m[2]), text: m[3].trim() });
}
if (!comments.length) {
  console.log('no comment lines on stdin');
  process.exit(0);
}

const words = t =>
  t
    .replace(/^[/*#\s]+/, '')
    .replace(/`[^`]*`/g, ' ')
    .replace(/#\d+/g, ' ')
    .toLowerCase()
    .replace(/[^a-z0-9\s-]/g, ' ')
    .split(/\s+/)
    .filter(w => w.length > 2 && !STOP.has(w));

const files = new Set(comments.map(c => c.file));

// ── term pass ────────────────────────────────────────────────────────────
// A term is interesting when it is RARE across files but recurs anyway: a
// word in most files is vocabulary, a word in two of thirty is a fact.
const termFiles = new Map();
for (const c of comments) {
  for (const w of new Set(words(c.text))) {
    if (!termFiles.has(w)) termFiles.set(w, new Map());
    if (!termFiles.get(w).has(c.file)) termFiles.get(w).set(c.file, []);
    termFiles.get(w).get(c.file).push(c.line);
  }
}

const ubiquitous = Math.max(3, Math.ceil(files.size * 0.6));
const rare = [...termFiles.entries()]
  .filter(([, homes]) => homes.size >= MIN_FILES && homes.size <= ubiquitous)
  .map(([term, homes]) => ({ term, homes }));

// Group terms that travel together: the same file set means the same fact.
const byFileSet = new Map();
for (const { term, homes } of rare) {
  const key = [...homes.keys()].sort().join(' ');
  if (!byFileSet.has(key)) byFileSet.set(key, { terms: [], homes });
  byFileSet.get(key).terms.push(term);
}

const clusters = [...byFileSet.values()]
  .filter(c => c.terms.length >= 2)
  .sort((a, b) => b.homes.size * b.terms.length - a.homes.size * a.terms.length)
  .slice(0, TOP);

console.log(`${comments.length} comment lines across ${files.size} files\n`);

if (!clusters.length) {
  console.log('TERM PASS: no term set recurs across files. Duplication is unlikely,');
  console.log('but run with --min-files 2 --top 30 before concluding there is none.');
} else {
  console.log(`TERM PASS: ${clusters.length} candidate cluster(s), paraphrase included\n`);
  for (const { terms, homes } of clusters) {
    console.log(`  terms: ${terms.slice(0, 8).join(', ')}${terms.length > 8 ? ` (+${terms.length - 8})` : ''}`);
    console.log(`  ${homes.size} files:`);
    for (const [f, ls] of homes) console.log(`    ${f}:${ls.slice(0, 4).join(',')}`);
    console.log('');
  }
}

// ── verbatim pass ────────────────────────────────────────────────────────
if (values.verbatim || !clusters.length) {
  const byPhrase = new Map();
  for (const c of comments) {
    const w = words(c.text);
    for (let i = 0; i + NGRAM <= w.length; i++) {
      const p = w.slice(i, i + NGRAM).join(' ');
      if (!byPhrase.has(p)) byPhrase.set(p, new Map());
      if (!byPhrase.get(p).has(c.file)) byPhrase.get(p).set(c.file, c.line);
    }
  }
  const exact = [...byPhrase.entries()]
    .filter(([, h]) => h.size >= MIN_FILES)
    .sort((a, b) => b[1].size - a[1].size || b[0].length - a[0].length);

  console.log(`\nVERBATIM PASS (${NGRAM}-grams): ${exact.length} cluster(s)\n`);
  for (const [phrase, homes] of exact.slice(0, TOP)) {
    console.log(`  "${phrase}"`);
    for (const [f, l] of homes) console.log(`    ${f}:${l}`);
    console.log('');
  }
}

console.log('\nEach cluster is a candidate. Read the lines before calling it a finding.');
