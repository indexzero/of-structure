#!/usr/bin/env node
// Count comment and code lines per file with cloc. With --check, hold each
// file to the limits and exceptions in comments.json.
import { cli, finish, listFiles, loadConfig, mergeBase, run } from '../lib/common.mjs';

const USAGE = `usage: comment-count [--base <rev>] [--head <rev>] [--config <file>] [--check] [--json] [path...] [-- <cloc option>...]

Without --base, count every selected file in the working tree.
With --base, count the lines that <head> (default HEAD) adds or modifies
since its merge base with <rev>. cloc compares commits, so uncommitted
changes are not counted.

cloc counts a line that holds both code and a comment as code. Its options
file is the "cloc" key of comments.json.

--check applies limits.ratio (comment lines per code line) to each file,
and limits.physical (lines per file) without --base. With --base, a file
with fewer than limits.minLines written lines is not held to the ratio.
--json prints the rows. A ratio is null when a file has comment lines and
no code lines.

Exits 1 when --check finds a file over a limit, and 2 when it cannot run.`;

const opts = cli(
  {
    base: { type: 'string' },
    head: { type: 'string', default: 'HEAD' },
    config: { type: 'string' },
    check: { type: 'boolean' },
    json: { type: 'boolean' },
  },
  USAGE
);
const config = loadConfig(opts.config);
// --config also keeps cloc from reading ~/.config/cloc/options.txt.
const CLOC = ['--by-file', '--json', '--quiet', '--skip-uniqueness', ...(config.cloc ? ['--config', config.cloc] : []), ...opts.passthrough];

let files;
let rows;
if (opts.base) {
  const base = mergeBase(opts.base, opts.head);
  files = listFiles(config, opts.paths, { base, against: opts.head });
  // cloc reports a renamed file under its old path.
  const renamed = new Map();
  const status = run('git', ['diff', '--name-status', '-M', '-z', base, opts.head]).stdout.split('\0');
  for (let i = 0; i < status.length; i++) {
    if (/^[RC]\d*$/.test(status[i])) {
      renamed.set(status[i + 2], status[i + 1]);
      i += 2;
    }
  }
  const out = files.length ? JSON.parse(run('cloc', ['--git', '--diff', base, opts.head, ...CLOC]).stdout) : {};
  const n = (part, f, k) => out[part]?.[f]?.[k] ?? 0;
  rows = files
    .map(file => ({ file, key: renamed.get(file) ?? file }))
    .filter(({ key }) => ['added', 'modified', 'same', 'removed'].some(part => out[part]?.[key]))
    .map(({ file, key }) => ({
      file,
      comment: n('added', key, 'comment') + n('modified', key, 'comment'),
      code: n('added', key, 'code') + n('modified', key, 'code'),
    }));
  if (opts.head === 'HEAD' && files.length) {
    const dirty = run('git', ['status', '--porcelain', '-z', '--', ...files]).stdout.split('\0').filter(Boolean);
    if (dirty.length) console.error(`comment-count: counts commits; ${dirty.length} selected file(s) have uncommitted changes`);
  }
} else {
  files = listFiles(config, opts.paths);
  const out = files.length ? JSON.parse(run('cloc', ['--list-file=-', ...CLOC], { input: files.join('\n') }).stdout) : {};
  rows = files
    .filter(f => out[f])
    .map(file => ({ file, comment: out[file].comment, code: out[file].code, physical: out[file].comment + out[file].code + out[file].blank }));
}
// cloc skips a language it does not know, and always skips the
// directories .config and .venv, whatever --exclude-dir says.
const counted = new Set(rows.map(r => r.file));
const skipped = files.filter(f => !counted.has(f));
if (skipped.length) {
  console.error(`comment-count: cloc did not count ${skipped.length} selected file(s), such as ${skipped.slice(0, 3).join(', ')}. It skips languages it does not know, and every .config and .venv directory.`);
}

const ratio = r => (r.code ? r.comment / r.code : r.comment ? Infinity : 0);
const total = rows.reduce((t, r) => ({ comment: t.comment + r.comment, code: t.code + r.code }), { comment: 0, code: 0 });

const violations = [];
if (opts.check) {
  const limits = config.limits ?? {};
  for (const r of rows) {
    const exception = config.exceptions?.[r.file] ?? {};
    const maxRatio = exception.ratio ?? limits.ratio;
    const maxPhysical = exception.physical ?? limits.physical;
    if (opts.base && r.comment + r.code < (limits.minLines ?? 0)) continue;
    if (maxRatio != null && ratio(r) > maxRatio) violations.push(`${r.file}: ratio ${ratio(r).toFixed(2)} > ${maxRatio}`);
    if (!opts.base && maxPhysical != null && r.physical > maxPhysical) violations.push(`${r.file}: physical ${r.physical} > ${maxPhysical}`);
  }
  // An exception outlives its file only by mistake. Checked on full runs,
  // where every file is in view.
  if (!opts.base && !opts.paths.length) {
    const seen = new Set(rows.map(r => r.file));
    for (const f of Object.keys(config.exceptions ?? {})) {
      if (!seen.has(f)) violations.push(`${f}: an exception in ${config.file} names a file that is not counted`);
    }
  }
}

let text;
if (opts.json) {
  const json = r => ({ ...r, ratio: Number.isFinite(ratio(r)) ? ratio(r) : null });
  text = `${JSON.stringify({ rows: rows.map(json), total: json(total), violations }, null, 2)}\n`;
} else {
  const show = n => (Number.isFinite(n) ? n.toFixed(2) : 'inf');
  const width = Math.max(20, ...rows.map(r => r.file.length));
  const line = (f, c, k, q) => `${f.padEnd(width)} ${String(c).padStart(6)} ${String(k).padStart(6)} ${q.padStart(6)}\n`;
  text = line('file', 'cmt', 'code', 'ratio');
  for (const r of [...rows].sort((a, b) => b.comment + b.code - (a.comment + a.code))) {
    if (r.comment + r.code) text += line(r.file, r.comment, r.code, show(ratio(r)));
  }
  text += `${'-'.repeat(width + 21)}\n${line('TOTAL', total.comment, total.code, show(ratio(total)))}`;
  for (const v of violations) text += `over the limit: ${v}\n`;
}
finish(text, violations.length ? 1 : 0);
